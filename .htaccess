Options -MultiViews -Indexes

<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Redireciona tudo para o index.php, exceto arquivos e diretórios que realmente existem
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

